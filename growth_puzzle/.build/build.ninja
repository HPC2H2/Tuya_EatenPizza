# =============================================================================
# Link build statements for STATIC_LIBRARY target libcjson


#############################################
# Link the static library lib\liblibcjson.a

build lib/liblibcjson.a: C_STATIC_LIBRARY_LINKER__libcjson_ src/libcjson/CMakeFiles/libcjson.dir/cJSON/cJSON.c.obj
  LANGUAGE_COMPILE_FLAGS = -g -Os -std=c99 -nostdlib -mthumb -Wall -Werror -Wno-format -Wno-unknown-pragmas -Wno-address-of-packed-member -ffunction-sections -fsigned-char -fdata-sections -fno-strict-aliasing -ggdb -std=gnu99 -Wno-old-style-declaration -mcpu=cortex-m33+nodsp -mfpu=fpv5-sp-d16 -mfloat-abi=hard -mcmse -end-group
  OBJECT_DIR = src\libcjson\CMakeFiles\libcjson.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = src\libcjson\CMakeFiles\libcjson.dir\libcjson.pdb
  TARGET_FILE = lib\liblibcjson.a
  TARGET_PDB = lib\liblibcjson.pdb


#############################################
# Utility command for edit_cache

build src/libcjson/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D E:\TuyaOpen\apps\Tuya-GrowthPuzzle\growth_puzzle\.build\src\libcjson && E:\TuyaOpen\.venv\Lib\site-packages\cmake\data\bin\cmake-gui.exe -SE:\TuyaOpen -BE:\TuyaOpen\apps\Tuya-GrowthPuzzle\growth_puzzle\.build"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build src/libcjson/edit_cache: phony src/libcjson/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build src/libcjson/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D E:\TuyaOpen\apps\Tuya-GrowthPuzzle\growth_puzzle\.build\src\libcjson && E:\TuyaOpen\.venv\Lib\site-packages\cmake\data\bin\cmake.exe --regenerate-during-build -SE:\TuyaOpen -BE:\TuyaOpen\apps\Tuya-GrowthPuzzle\growth_puzzle\.build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build src/libcjson/rebuild_cache: phony src/libcjson/CMakeFiles/rebuild_cache.util

