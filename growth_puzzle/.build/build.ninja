# =============================================================================
# Link build statements for STATIC_LIBRARY target libmqtt


#############################################
# Link the static library lib\liblibmqtt.a

build lib/liblibmqtt.a: C_STATIC_LIBRARY_LINKER__libmqtt_ src/libmqtt/CMakeFiles/libmqtt.dir/coreMQTT/source/core_mqtt.c.obj src/libmqtt/CMakeFiles/libmqtt.dir/coreMQTT/source/core_mqtt_serializer.c.obj src/libmqtt/CMakeFiles/libmqtt.dir/coreMQTT/source/core_mqtt_state.c.obj src/libmqtt/CMakeFiles/libmqtt.dir/src/mqtt_client_wrapper.c.obj
  LANGUAGE_COMPILE_FLAGS = -g -Os -std=c99 -nostdlib -mthumb -Wall -Werror -Wno-format -Wno-unknown-pragmas -Wno-address-of-packed-member -ffunction-sections -fsigned-char -fdata-sections -fno-strict-aliasing -ggdb -std=gnu99 -Wno-old-style-declaration -mcpu=cortex-m33+nodsp -mfpu=fpv5-sp-d16 -mfloat-abi=hard -mcmse -end-group
  OBJECT_DIR = src\libmqtt\CMakeFiles\libmqtt.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = src\libmqtt\CMakeFiles\libmqtt.dir\libmqtt.pdb
  TARGET_FILE = lib\liblibmqtt.a
  TARGET_PDB = lib\liblibmqtt.pdb


#############################################
# Utility command for edit_cache

build src/libmqtt/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D E:\TuyaOpen\apps\Tuya-GrowthPuzzle\growth_puzzle\.build\src\libmqtt && E:\TuyaOpen\.venv\Lib\site-packages\cmake\data\bin\cmake-gui.exe -SE:\TuyaOpen -BE:\TuyaOpen\apps\Tuya-GrowthPuzzle\growth_puzzle\.build"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build src/libmqtt/edit_cache: phony src/libmqtt/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build src/libmqtt/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D E:\TuyaOpen\apps\Tuya-GrowthPuzzle\growth_puzzle\.build\src\libmqtt && E:\TuyaOpen\.venv\Lib\site-packages\cmake\data\bin\cmake.exe --regenerate-during-build -SE:\TuyaOpen -BE:\TuyaOpen\apps\Tuya-GrowthPuzzle\growth_puzzle\.build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build src/libmqtt/rebuild_cache: phony src/libmqtt/CMakeFiles/rebuild_cache.util

